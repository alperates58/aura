# ==========================================
# AURA - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env)
# ==========================================

# Ortam ve Genel Yapılandırma
ENVIRONMENT=production
DOMAIN=aura.example.com

# Servis Portları (Backend ve Frontend portları ayrıştırılmıştır; global PORT değişkeni kullanmayın)
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Dağıtım Taban Yolu (Kök domain için boş bırakın "", alt yol için "/app" yapın)
APP_BASE_PATH=
COOKIE_PATH=/
NEXT_PUBLIC_BASE_PATH=

# CORS İzinli Origin Listesi (Virgülle ayrılmış tam URL'ler)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# PostgreSQL 16
POSTGRES_HOST=aura-postgres
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=
POSTGRES_DB=aura
POSTGRES_DATA_PATH=/data/aura/db/postgres
DATABASE_URL=postgres://aura_user:PASSWORD@aura-postgres:5432/aura?sslmode=disable

# Redis 7
REDIS_HOST=aura-redis
REDIS_ADDR=aura-redis:6379
REDIS_PASSWORD=
REDIS_DATA_PATH=/data/aura/db/redis

# MinIO S3 Nesne Depolama
MINIO_HOST=aura-minio
MINIO_ROOT_USER=aura_admin
MINIO_ROOT_PASSWORD=
MINIO_DATA_PATH=/data/aura/storage/minio
MINIO_ENDPOINT=aura-minio:9000
MINIO_PUBLIC_URL=https://s3.aura.example.com
MINIO_USE_SSL=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_VOICE=audio-messages
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_FILES=files

# LiveKit SFU (WebRTC Sesli & Görüntülü Arama)
LIVEKIT_HOST=aura-livekit
LIVEKIT_URL=http://aura-livekit:7880
LIVEKIT_PUBLIC_URL=https://livekit.aura.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# JWT & Oturum Güvenliği
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# Web Push Bildirimleri (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER_EMAIL=mailto:admin@example.com

# Frontend Next.js Public Değişkenleri (Build ve Runtime)
NEXT_PUBLIC_API_URL=https://api.aura.example.com
NEXT_PUBLIC_WS_URL=wss://api.aura.example.com/ws
NEXT_PUBLIC_LIVEKIT_URL=https://livekit.aura.example.com

# Traefik Yönlendirme Kuralları (Kök domain veya alt path için özelleştirilebilir)
# Kök domain varsayılanları:
# 1. Catch-all HTTPS Router (Statik assetler, _rsc, fetch/xhr, favicon, manifest - Basic Auth challenge üretmez)
TRAEFIK_FRONTEND_RULE=Host(`aura.example.com`)
TRAEFIK_FRONTEND_MIDDLEWARES=crowdsec@file
TRAEFIK_FRONTEND_PRIORITY=50
# 2. Document/Navigation HTTPS Router (Yalnızca gerçek HTML navigation istekleri - Basic Auth + CrowdSec)
TRAEFIK_FRONTEND_DOCUMENT_RULE=
TRAEFIK_FRONTEND_DOCUMENT_MIDDLEWARES=crowdsec@file
TRAEFIK_FRONTEND_DOCUMENT_PRIORITY=60
TRAEFIK_BACKEND_RULE=Host(`api.aura.example.com`)
TRAEFIK_BACKEND_MIDDLEWARES=crowdsec@file
TRAEFIK_BACKEND_STRIP_PREFIX=
TRAEFIK_BACKEND_PRIORITY=100
TRAEFIK_LIVEKIT_RULE=Host(`livekit.aura.example.com`)
# Tek domain kurulumunda (ayrı livekit subdomain DNS kaydı yoksa) /rtc ve /livekit path router kullanılır:
TRAEFIK_LIVEKIT_PATH_RULE=Host(`aura.example.com`) && (PathPrefix(`/rtc`) || PathPrefix(`/livekit`))
TRAEFIK_LIVEKIT_PATH_PRIORITY=150
TRAEFIK_ENABLE_S3=true
TRAEFIK_S3_RULE=Host(`s3.aura.example.com`)
TRAEFIK_S3_MIDDLEWARES=crowdsec@file
TRAEFIK_S3_STRIP_PREFIX=
TRAEFIK_S3_PRIORITY=120

# ----------------------------------------------------
# ÖRNEK: ALT YOL (SUBPATH) DAĞITIMI (example.com/app)
# ----------------------------------------------------
# DOMAIN=example.com
# APP_BASE_PATH=/app
# COOKIE_PATH=/app
# NEXT_PUBLIC_BASE_PATH=/app
# CORS_ALLOWED_ORIGINS=https://example.com
# NEXT_PUBLIC_API_URL=https://example.com/app/api
# NEXT_PUBLIC_WS_URL=wss://example.com/app/ws
#
# LiveKit SFU (WebRTC Görüşme):
# - Tek domain kullanılıyorsa (livekit.example.com DNS kaydı yoksa):
#   LIVEKIT_PUBLIC_URL=https://example.com
#   NEXT_PUBLIC_LIVEKIT_URL=https://example.com
#   TRAEFIK_LIVEKIT_PATH_RULE=Host(`example.com`) && (PathPrefix(`/rtc`) || PathPrefix(`/livekit`))
# - Ayrı subdomain DNS kaydı varsa:
#   LIVEKIT_PUBLIC_URL=https://livekit.example.com
#   NEXT_PUBLIC_LIVEKIT_URL=https://livekit.example.com
#   TRAEFIK_LIVEKIT_RULE=Host(`livekit.example.com`)
#
# MINIO_PUBLIC_URL=https://example.com/app/s3
# TRAEFIK_FRONTEND_RULE=Host(`example.com`) && (Path(`/app`) || PathPrefix(`/app/`))
# TRAEFIK_FRONTEND_MIDDLEWARES=crowdsec@file
# TRAEFIK_FRONTEND_PRIORITY=50
# TRAEFIK_FRONTEND_DOCUMENT_RULE=
# TRAEFIK_FRONTEND_DOCUMENT_MIDDLEWARES=aura-auth@file,crowdsec@file
# TRAEFIK_FRONTEND_DOCUMENT_PRIORITY=60
# TRAEFIK_BACKEND_RULE=Host(`example.com`) && (PathPrefix(`/app/api`) || PathPrefix(`/app/ws`))
# TRAEFIK_BACKEND_MIDDLEWARES=aura-backend-strip,crowdsec@file
# TRAEFIK_BACKEND_STRIP_PREFIX=/app
# TRAEFIK_BACKEND_PRIORITY=100
# TRAEFIK_ENABLE_S3=true
# TRAEFIK_S3_RULE=Host(`example.com`) && PathPrefix(`/app/s3`)
# TRAEFIK_S3_MIDDLEWARES=aura-s3-strip,crowdsec@file
# TRAEFIK_S3_STRIP_PREFIX=/app/s3
# TRAEFIK_S3_PRIORITY=120
